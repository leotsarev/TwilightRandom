@page
@using Twilight.Domain;
@using Components
@using JoinRpg.Common.WebComponents
@model Twilight.Web.Pages.GameCreateModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Создание игры</h1>
</div>

<form method="post">
    Название игры:
    <br /> <input asp-for="Name" />
    <br />
    <label>Дата проведения:</label>
    <component type="typeof(JoinRpgDatePicker)" render-mode="Static" param-Name='"Date"' param-Value="@Model.Date" />
    <br/>
    Список игроков (на отдельной строке, можно указать joinrpg id через "#", например "Вася #12345"):
    <br /><textarea asp-for="PlayerList" rows="8" cols="20"> </textarea>
    <br /><input asp-for="AddToEightPlayers" id="check8"/> <label for="check8">Дополнить список игроков до восьми</label>
    <br /><label>Режим альянса:</label><select asp-for="AllianceMode" asp-items="Html.GetEnumSelectList<AllianceMode>()" id="allianceMode"></select>
    <br/><label>Фракций на выбор:</label><component type="typeof(FactionsCountSelect)" render-mode="Static" param-Name='"FactionsPerPlayer"' param-Value="@Model.FactionsPerPlayer" />
    <br /><input type="submit" value="Создать" />
</form>