@page
@using Twilight.Domain
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
   <ul>
       <li><a asp-page="GameCreate">Создание игры</a></li>
   </ul>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <h2>Мои игры</h2>
    @if (Model.MyGames.Count == 0)
    {
        <p>Вы пока не участвовали ни в одной игре.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Игра</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Кем я играл</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model.MyGames)
                {
                    <tr>
                        <td><a asp-page="GameView" asp-route-Id="@game.Id">@game.Name</a></td>
                        <td>@(game.Date is not null ? game.Date.Value.ToString("d MMMM yyyy") : "")</td>
                        <td>@(game.Status switch
                        {
                            GameStatus.ChoosingSides => "Выбираем стороны",
                            GameStatus.Planned => "Запланирована",
                            GameStatus.Played => "Прошла",
                            GameStatus.Cancelled => "Отменена",
                            _ => game.Status.ToString(),
                        })</td>
                        <td>@Model.GetMyFaction(game)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
