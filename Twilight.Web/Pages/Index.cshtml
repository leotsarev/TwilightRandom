@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
   <ul>
       <li><a asp-page="GameCreate">Создание игры</a></li>
   </ul>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <h2>Мои игры</h2>
    @if (Model.MyGames.Count == 0)
    {
        <p>Вы пока не участвовали ни в одной игре.</p>
    }
    else
    {
        <ul>
            @foreach (var game in Model.MyGames)
            {
                <li><a asp-page="GameView" asp-route-Id="@game.Id">@game.Name</a></li>
            }
        </ul>
    }
}
