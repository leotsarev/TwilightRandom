@page
@using Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
   @if (User.Identity?.IsAuthenticated == true)
   {
       <ul>
           <li><a asp-page="GameCreate">Создание игры</a></li>
       </ul>
   }
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <h2>Мои игры</h2>
    @if (Model.MyGames.Count == 0)
    {
        <p>Вы пока не участвовали ни в одной игре.</p>
    }
    else
    {
        <component type="typeof(PlayerGamesTable)" render-mode="Static" param-Games="Model.MyGames" param-PlayerJoinrpgUserId="Model.MyJoinrpgUserId!" />
    }
}
