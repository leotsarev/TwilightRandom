@page
@using Components
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
   @if (User.Identity?.IsAuthenticated == true)
   {
       <ul>
           <li><a asp-page="GameCreate">Создание игры</a></li>
       </ul>
   }
</div>

<h2>Игры</h2>
@if (Model.Games.Count == 0)
{
    <p>Пока не создано ни одной игры.</p>
}
else
{
    <component type="typeof(AllGamesTable)" render-mode="Static" param-Games="Model.Games" />
}
