@page
@model Twilight.Web.Pages.GameFinishModel
@{
    ViewData["Title"] = "Игра прошла";
}

<div class="text-center">
    <h1 class="display-4">Итоги игры</h1>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert-danger">@Model.Message</div>
}

<form method="post">
    <div class="mb-3">
        <label for="name" class="form-label">Название игры</label>
        <input type="text" class="form-control" id="name" name="name" value="@Model.Game.Name" required />
    </div>
    <div class="mb-3">
        <label for="notes" class="form-label">Заметки</label>
        <textarea class="form-control" id="notes" name="notes" rows="4">@Model.Game.Notes</textarea>
    </div>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Игрок</th>
                <th>Фракция</th>
                <th>Очки</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in Model.Game.PlayerSlots)
            {
                <tr>
                    <td>
                        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" stroke="black" fill="@slot.Color"
                         width="20" heigth="20">
                            <circle cx="8" cy="8" r="5" />
                        </svg>
                        @slot.Player.Name
                    </td>
                    <td>@slot.SelectedFaction</td>
                    <td><input type="number" min="0" max="14" name="points[@slot.Id]" value="@slot.Points" required /></td>
                </tr>
            }
        </tbody>
    </table>
    <input type="submit" class="btn btn-primary" value="Завершить игру" />
</form>
