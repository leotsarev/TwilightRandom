@page
@using Components
@using JoinRpg.Common.WebComponents
@using Twilight.Domain
@model Twilight.Web.Pages.GameViewModel
@{
    ViewData["Title"] = "Страница игры";
}
<div class="text-center">
    <h1 class="display-4">Страница игры @Model.Game.Name</h1>
    <p>
        @if (Model.Game.Date is not null)
        {
            <span>Дата: @Model.Game.Date.Value.ToString("d MMMM yyyy")</span>
            <br />
        }
        <span>Статус: @(Model.Game.Status switch
        {
            GameStatus.ChoosingSides => "Выбираем стороны",
            GameStatus.Planned => "Запланирована",
            GameStatus.Played => "Прошла",
            GameStatus.Cancelled => "Отменена",
            _ => Model.Game.Status.ToString(),
        })</span>
    </p>
    @if (Model.Message is not null)
    {
        <div class="alert alert-danger">@Model.Message</div>
    }
    @if (Model.CanManage && Model.Game.Status != GameStatus.Played)
    {
        @if (Model.AllSelected)
        {
            <a asp-page="GameFinish" asp-route-Id="@Model.Game.Id" class="btn btn-primary">Игра прошла</a>
        }
        else
        {
            <button class="btn btn-primary" disabled title="Не все игроки выбрали фракцию">Игра прошла</button>
        }
    }
    @if (Model.CanDeleteGame)
    {
        <a asp-page="GameDelete" asp-route-Id="@Model.Game.Id" class="btn btn-danger">Удалить игру</a>
    }
    @if (Model.CanCancelGame)
    {
        <a asp-page="GameCancel" asp-route-Id="@Model.Game.Id" class="btn btn-outline-danger">Отменить игру</a>
    }
    @if (Model.ShowAddPlayer)
    {
        @if (Model.AddPlayerDisabledReason is null)
        {
            <a asp-page="GamePlayerAdd" asp-route-Id="@Model.Game.Id" class="btn btn-secondary">Добавить игрока</a>
        }
        else
        {
            <button class="btn btn-secondary" disabled title="@Model.AddPlayerDisabledReason">Добавить игрока</button>
        }
    }
</div>

@if (!string.IsNullOrWhiteSpace(Model.Game.Notes))
{
    <div class="alert alert-secondary">@Model.Game.Notes</div>
}


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Игрок</th>
            <th>Фракция</th>
            @if (!Model.AllSelected)
            {
                <th>Выбрано?</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach(var slot in Model.Game.PlayerSlots)
        {
            <tr>
                <td>
                    <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" stroke="black" fill="@slot.Color"
                     width="20" heigth="20">
                        <circle cx="8" cy="8" r="5" />
                    </svg>
                    @if (slot.Player.JoinrpgUserId is not null)
                    {
                        <a href="/user/@slot.Player.JoinrpgUserId.Value">@slot.Player.Name</a>
                    }
                    else
                    {
                        @slot.Player.Name
                    }
                    @if (Model.CanManage && !Model.AllSelected && slot.Player.JoinrpgUserId is null)
                    {
                        <a asp-page="GameView" asp-route-Id="@Model.Game.Id" asp-route-SlotSlug="@slot.Slug">(ссылка)</a>
                    }
                    @if (Model.CanManage && Model.Game.Status != GameStatus.Played)
                    {
                        <a asp-page="GamePlayerChange" asp-route-Id="@Model.Game.Id" asp-route-SlotId="@slot.Id" title="Сменить игрока">
                            <component type="typeof(JoinIcon)" render-mode="Static" param-Icon="JoinIconType.Edit" />
                        </a>
                    }
                    @if (slot.AlliedWith is not null)
                    {
                        <i>(союзник: @slot.AlliedWith)</i>
                    }
                    @if (slot.Speaker)
                    {
                        <img src="~/img/speaker.webp" alt="Speaker">
                    }
                    @if (slot.ChoosePlace)
                    {
                        <b><img src="~/img/chair.svg" alt="Выбирает место" title="Выбирает место" width="30" height="30"/></b>
                    }
                    @if (slot.Id == Model.SlotId)
                    {
                        <br />
                        <i> (это вы)</i>
                    }
                    @if (Model.Game.Status == GameStatus.Played && slot.Points is not null)
                    {
                        <br />
                        <span>@slot.Points очков</span>
                        @if (slot.IsWinner)
                        {
                            <span title="Победитель">🏆</span>
                        }
                    }
                </td>
                <td>
                    @foreach (var faction in slot.PossibleFactions)
                    {
                        @if (slot.Id == Model.SlotId && slot.SelectedFaction is null)
                        {
                                <form asp-page="PlayerSelect">
                                    <input type="hidden" name="SlotSlug" value="@slot.Slug" />
                                    <input type="hidden" name="GameId" value="@Model.Game.Id" />
                                    <input type="hidden" name="FactionId" value="@faction.Id" />
                                    <input type="submit" value="Выбрать" />
                                <component type="typeof(FactionLink)" render-mode="Static" param-Faction="@faction" param-ShowAllianceCard="Model.Alliances" />
                            </form>
                        }
                        else if (slot.SelectedFaction is not null && slot.SelectedFaction != faction && (slot.Id == Model.SlotId || Model.AllSelected))
                        {
                            <component type="typeof(FactionLink)" render-mode="Static" param-Faction="@faction" param-StrikedOut="true" param-ShowAllianceCard="Model.Alliances" />
                        }
                        else if (slot.SelectedFaction == faction && (slot.Id == Model.SlotId || Model.AllSelected))
                        {
                            <component type="typeof(FactionLink)" render-mode="Static" param-Faction="@faction" param-Selected="true" param-ShowAllianceCard="Model.Alliances" />
                        }
                        else
                        {
                            <component type="typeof(FactionLink)" render-mode="Static" param-Faction="@faction" param-ShowAllianceCard="Model.Alliances" />
                        }
                    }

                    @if (slot.SelectedFaction is not null && !slot.PossibleFactions.Contains(slot.SelectedFaction)  && (slot.Id == Model.SlotId || Model.AllSelected))
                    {
                        <component type="typeof(FactionLink)" render-mode="Static" param-Faction="@slot.SelectedFaction" param-Selected="true" param-ShowAllianceCard="Model.Alliances" />
                    }
                    @if (slot.Id == Model.SlotId && slot.SelectedFaction is null)
                    {
                        <form asp-page="PlayerSelect">
                            <input type="hidden" name="SlotSlug" value="@slot.Slug" />
                            <input type="hidden" name="GameId" value="@Model.Game.Id" />
                            <input type="submit" value="Выбрать" />
                            Случайная
                        </form>
                    }
                </td>
                @if (!Model.AllSelected)
                {
                    <td>
                        @if (slot.SelectedFaction is null)
                        {
                            <span>??</span>
                        }
                        else
                        {
                            <span>!!</span>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<h3>Невыбранные фракции</h3>
<ul>
@foreach (var faction in Model.UnUsedFactions)
{
        <li><component type="typeof(FactionLink)" render-mode="Static" param-Faction="@faction" param-ShowAllianceCard="Model.Alliances" /> </li>
}
</ul>