@page
@model Twilight.Web.Pages.GamePlayerChangeModel
@{
    ViewData["Title"] = "Смена игрока";
}

<div class="text-center">
    <h1 class="display-4">Сменить игрока в игре @Model.Game.Name</h1>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert-danger">@Model.Message</div>
}

<form method="post">
    <div class="mb-3">
        <label for="name" class="form-label">Имя игрока</label>
        <input type="text" class="form-control" id="name" name="Name" value="@Model.Name" required />
    </div>
    <input type="submit" class="btn btn-primary" value="Сохранить" />
    <a asp-page="GameView" asp-route-Id="@Model.Id" class="btn btn-secondary">Отмена</a>
</form>
