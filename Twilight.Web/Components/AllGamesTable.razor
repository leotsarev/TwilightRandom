@using Twilight.Domain

<table class="table">
    <thead>
        <tr>
            <th>Игра</th>
            <th>Дата</th>
            <th>Статус</th>
            <th>Победитель</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var game in Games)
        {
            var winnerSlot = game.PlayerSlots.FirstOrDefault(ps => ps.IsWinner);
            <tr>
                <td><a href="/GameView?Id=@game.Id">@game.Name</a></td>
                <td>@(game.Date is not null ? game.Date.Value.ToString("d MMMM yyyy") : "")</td>
                <td>@(game.Status switch
                {
                    GameStatus.ChoosingSides => "Выбираем стороны",
                    GameStatus.Planned => "Запланирована",
                    GameStatus.Played => "Прошла",
                    GameStatus.Cancelled => "Отменена",
                    _ => game.Status.ToString(),
                })</td>
                <td>
                    @if (winnerSlot is not null)
                    {
                        @winnerSlot.Player.Name
                        @if (winnerSlot.SelectedFaction is not null)
                        {
                            <text> (@winnerSlot.SelectedFaction.ToString())</text>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter]
    [EditorRequired]
    public List<Game> Games { get; set; } = null!;
}
